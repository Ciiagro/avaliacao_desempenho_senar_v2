# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
#
# No painel do Supabase: Project Settings > Database > Connection string > URI
# (use o modo "Session pooling" ou a conexão direta, ambos funcionam com SQLAlchemy)
#
# Exemplo:

DATABASE_URL=postgresql://postgres.rtygcapxhlnikbuxsvpk:U4Wabi1pnGOCX3Z4@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave secreta do Flask (para sessão). Gere uma string aleatória qualquer.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Senha de acesso à área de Administração (só o gestor de RH deve ter essa senha)
ADMIN_PASSWORD=troque-esta-senha

COMISSAO_PASSWORD=teste2026

# E-mail (Gmail) para avisar a Comissão quando chegar um recurso novo.
# 1) Use uma conta do Gmail (pode ser a conta institucional, se for Google Workspace).
# 2) Ative a verificação em 2 etapas nessa conta.
# 3) Gere uma "senha de app" em: https://myaccount.google.com/apppasswords
#    (é uma senha de 16 letras, só para uso por programas — NÃO é a senha normal da conta)
# 4) Preencha os dois campos abaixo com o e-mail e essa senha de app.
MAIL_USERNAME=
MAIL_APP_PASSWORD=

FLASK_DEBUG=1
